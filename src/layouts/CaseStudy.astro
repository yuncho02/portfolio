{
  hasAnchors && (
    <script>
      function initCaseStudyAnchors() {
        const nav = document.querySelector("[data-anchor-nav]");
        const inner = document.querySelector("[data-anchor-nav-inner]");
        if (!(nav instanceof HTMLElement) || !(inner instanceof HTMLElement)) return;

        const links = Array.from(
          nav.querySelectorAll("[data-anchor-link]"),
        );

        const syncFixedLeft = () => {
          const rect = nav.getBoundingClientRect();
          inner.style.left = `${Math.round(rect.left)}px`;
        };

        const sections = links
          .map((link) => {
            if (!(link instanceof HTMLAnchorElement)) return null;
            const id = link.dataset.anchorLink;
            const el = id ? document.getElementById(id) : null;
            return el && id ? { id, link, el } : null;
          })
          .filter(Boolean);

        const setActive = (id) => {
          links.forEach((link) => {
            if (!(link instanceof HTMLElement)) return;
            link.classList.toggle("is-active", link.dataset.anchorLink === id);
          });
        };

        const syncActive = () => {
          if (!sections.length) return;
          const marker = window.scrollY + 140;
          let current = sections[0].id;
          for (const section of sections) {
            if (section.el.offsetTop <= marker) current = section.id;
          }
          setActive(current);
        };

        links.forEach((link) => {
          link.addEventListener("click", (event) => {
            if (!(link instanceof HTMLAnchorElement)) return;
            const id = link.dataset.anchorLink;
            const target = id ? document.getElementById(id) : null;
            if (!target || !id) return;
            event.preventDefault();
            target.scrollIntoView({ behavior: "smooth", block: "start" });
            history.replaceState(null, "", `#${id}`);
            setActive(id);
          });
        });

        window.addEventListener("scroll", syncActive, { passive: true });
        window.addEventListener("resize", syncFixedLeft);
        const ro = new ResizeObserver(syncFixedLeft);
        ro.observe(document.documentElement);
        syncFixedLeft();
        syncActive();
      }

      document.addEventListener("astro:page-load", initCaseStudyAnchors);
      initCaseStudyAnchors();
    </script>
  )
}

<script>
  function animateCount(el: HTMLElement, to: number, duration = 900) {
    const start = performance.now();
    const from = 0;
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = String(Math.round(from + (to - from) * eased));
      if (t < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  function initImpactBlocks() {
    const roots = document.querySelectorAll<HTMLElement>("[data-impact]");
    if (!roots.length) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    roots.forEach((root) => {
      if (root.dataset.bound === "true") return;
      root.dataset.bound = "true";

      const run = () => {
        root.classList.add("is-visible");
        if (reduced) {
          root.querySelectorAll<HTMLElement>("[data-count-to]").forEach((el) => {
            el.textContent = el.dataset.countTo ?? "0";
          });
          return;
        }
        root.querySelectorAll<HTMLElement>("[data-count-to]").forEach((el) => {
          const to = Number(el.dataset.countTo);
          if (!Number.isNaN(to)) animateCount(el, to);
        });
      };

      if (reduced) {
        run();
        return;
      }

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            run();
            io.disconnect();
          });
        },
        { threshold: 0.35 },
      );
      io.observe(root);
    });
  }

  function initCalloutReveal() {
    const callouts = document.querySelectorAll<HTMLElement>(".prose .callout");
    if (!callouts.length) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduced) {
      callouts.forEach((callout) => callout.classList.add("is-visible"));
      return;
    }

    const pending = [...callouts].filter(
      (callout) => !callout.classList.contains("is-visible"),
    );
    if (!pending.length) return;

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          el.classList.add("is-visible");
          io.unobserve(el);
        });
      },
      { threshold: 0.2, rootMargin: "0px 0px -10% 0px" },
    );

    pending.forEach((callout) => io.observe(callout));
  }

  function initFeatureVideos() {
    const videos = document.querySelectorAll<HTMLVideoElement>(".feature video");
    if (!videos.length) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    videos.forEach((video) => {
      video.pause();
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;
      if (reduced) return;
    });

    if (reduced) return;

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            video.muted = true;
            void video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      },
      { threshold: 0.35 },
    );

    videos.forEach((video) => io.observe(video));
  }

  function initMarkReveal() {
    const marks = document.querySelectorAll<HTMLElement>(".prose .mark");
    if (!marks.length) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduced) {
      marks.forEach((mark) => mark.classList.add("is-drawn"));
      return;
    }

    const pending = [...marks].filter((mark) => !mark.classList.contains("is-drawn"));
    if (!pending.length) return;

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          el.classList.add("is-drawn");
          io.unobserve(el);
        });
      },
      { threshold: 0.55, rootMargin: "0px 0px -8% 0px" },
    );

    pending.forEach((mark) => io.observe(mark));
  }

  function initImageLightbox() {
    const lightbox = document.querySelector<HTMLElement>("[data-image-lightbox]");
    const image = document.querySelector<HTMLImageElement>("[data-image-lightbox-image]");
    const closeBtn = document.querySelector<HTMLButtonElement>("[data-image-lightbox-close]");
    if (!lightbox || !image || !closeBtn) return;
    if (lightbox.dataset.bound === "true") return;
    lightbox.dataset.bound = "true";

    let lastFocus: HTMLElement | null = null;

    const open = (src: string, alt: string) => {
      lastFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      image.src = src;
      image.alt = alt || "Expanded image";
      lightbox.hidden = false;
      requestAnimationFrame(() => lightbox.classList.add("is-open"));
      document.documentElement.style.overflow = "hidden";
      closeBtn.focus();
    };

    const close = () => {
      lightbox.classList.remove("is-open");
      document.documentElement.style.overflow = "";
      const finish = () => {
        if (lightbox.classList.contains("is-open")) return;
        lightbox.hidden = true;
        image.removeAttribute("src");
        image.alt = "";
      };
      lightbox.addEventListener("transitionend", finish, { once: true });
      window.setTimeout(finish, 280);
      lastFocus?.focus();
      lastFocus = null;
    };

    const targets = document.querySelectorAll<HTMLImageElement>(
      ".page .media img.media-asset, .prose figure img, .prose .media-block img, .slideshow img",
    );

    targets.forEach((img) => {
      if (img.dataset.lightboxBound === "true") return;
      img.dataset.lightboxBound = "true";
      img.addEventListener("click", () => {
        const src = img.currentSrc || img.src;
        if (!src) return;
        open(src, img.alt);
      });
    });

    closeBtn.addEventListener("click", (event) => {
      event.stopPropagation();
      close();
    });

    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) close();
    });

    image.addEventListener("click", (event) => event.stopPropagation());

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (lightbox.hidden) return;
      close();
    });
  }

  document.addEventListener("astro:page-load", initImpactBlocks);
  document.addEventListener("astro:page-load", initCalloutReveal);
  document.addEventListener("astro:page-load", initFeatureVideos);
  document.addEventListener("astro:page-load", initMarkReveal);
  document.addEventListener("astro:page-load", initImageLightbox);
  initImpactBlocks();
  initCalloutReveal();
  initFeatureVideos();
  initMarkReveal();
  initImageLightbox();
</script>
