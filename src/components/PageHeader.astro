---
import Avatar from "./Avatar.astro";
import Nav from "./Nav.astro";
import ViewToggle from "./ViewToggle.astro";

interface Props {
  name: string;
  avatar?: string;
  lede: string;
  active: "work" | "art" | "about";
}

const { name, avatar, lede, active } = Astro.props;
---

<header class="top page-body" transition:animate="none">
  <div class="intro">
    <Avatar name={name} src={avatar} />
    <h1 class="lede">{lede}</h1>
  </div>

  <div class="controls" transition:persist="page-controls">
    <Nav active={active} />
    <ViewToggle visible={active === "work"} />
  </div>
</header>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 2;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-block: 0;
    margin-inline: auto;
    padding-top: 100px;
    padding-bottom: 0;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(3.5px);
    -webkit-backdrop-filter: blur(3.5px);
  }

  /* Grid view: document scroll — header must not stick/fix */
  :global(html[data-work-view="grid"]) .top,
  :global(.page--work[data-view="grid"]) .top {
    position: static;
    top: auto;
    z-index: auto;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    background: transparent;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .lede {
    margin: 0;
    max-width: 62ch;
    font-size: clamp(1.6rem, 1.1rem + 2vw, 2.25rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 20px;
  }

  @media (max-width: 640px) {
    .top {
      padding-top: 56px;
    }
  }
</style>
