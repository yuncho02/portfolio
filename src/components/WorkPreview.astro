---
---

<div class="preview" data-preview data-empty="true">
  <span class="preview-loading" data-preview-loading aria-hidden="true">Loading<span class="loading-ellipsis"></span></span>
  <img class="preview-media" data-preview-image alt="" hidden />
  <video
    class="preview-media"
    data-preview-video
    muted
    loop
    playsinline
    preload="auto"
    hidden
  ></video>
</div>

<style>
  .preview {
    position: relative;
    height: 100%;
    min-height: 420px;
    border-radius: 16px;
    background: transparent;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .preview[data-empty="false"] {
    opacity: 1;
  }

  .preview-loading {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-meta);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .preview[data-loading="true"] .preview-loading {
    opacity: 1;
  }

  .loading-ellipsis {
    display: inline-block;
    width: 1.15em;
    overflow: hidden;
    vertical-align: bottom;
    white-space: nowrap;
    animation: loading-ellipsis 1.2s steps(4, end) infinite;
  }

  .loading-ellipsis::before {
    content: "...";
  }

  @keyframes loading-ellipsis {
    0% {
      width: 0;
    }
    100% {
      width: 1.15em;
    }
  }

  .preview-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .preview-media.is-active {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .loading-ellipsis {
      animation: none;
      width: 1.15em;
    }

    .preview[data-loading="true"] .preview-loading {
      opacity: 0.7;
    }
  }
</style>

<script>
  function initWorkPreview() {
    const preview = document.querySelector<HTMLElement>("[data-preview]");
    const previewImage = document.querySelector<HTMLImageElement>("[data-preview-image]");
    const previewVideo = document.querySelector<HTMLVideoElement>("[data-preview-video]");
    const list = document.querySelector<HTMLElement>("[data-work-list]");

    if (!preview || !previewImage || !previewVideo || !list) return;
    if (list.dataset.previewBound === "true") return;
    list.dataset.previewBound = "true";

    const rows = Array.from(list.querySelectorAll<HTMLElement>(".row"));
    let token = 0;
    let activeRow: HTMLElement | null = null;

    const mediaUrl = (value?: string) => {
      if (!value) return "";
      try {
        return new URL(value, window.location.origin).href;
      } catch {
        return value;
      }
    };

    const imageCache = new Map<string, HTMLImageElement>();
    const videoCache = new Map<string, HTMLVideoElement>();

    const setLoading = (loading: boolean) => {
      if (loading) preview.dataset.loading = "true";
      else delete preview.dataset.loading;
    };

    const preloadImage = (src: string) => {
      const href = mediaUrl(src);
      if (!href || imageCache.has(href)) return imageCache.get(href);
      const img = new Image();
      img.decoding = "async";
      img.src = href;
      imageCache.set(href, img);
      return img;
    };

    const preloadVideo = (src: string) => {
      const href = mediaUrl(src);
      if (!href || videoCache.has(href)) return videoCache.get(href);
      const video = document.createElement("video");
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;
      video.preload = "auto";
      video.src = href;
      video.load();
      videoCache.set(href, video);
      return video;
    };

    const warmAll = () => {
      rows.forEach((row) => {
        const image = row.dataset.image?.trim();
        const video = row.dataset.video?.trim();
        if (image) preloadImage(image);
        if (video) preloadVideo(video);
      });
    };

    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(() => warmAll(), { timeout: 1200 });
    } else {
      window.setTimeout(warmAll, 200);
    }

    const hideVideo = () => {
      previewVideo.classList.remove("is-active");
      previewVideo.pause();
      previewVideo.hidden = true;
    };

    const hideImage = () => {
      previewImage.classList.remove("is-active");
      previewImage.hidden = true;
    };

    const clear = () => {
      token += 1;
      activeRow = null;
      preview.dataset.empty = "true";
      setLoading(false);
      hideImage();
      hideVideo();
      // Keep src buffers warm — do not tear down media.
    };

    const imageReady = (src: string) => {
      const href = mediaUrl(src);
      const cached = imageCache.get(href);
      return Boolean(
        (cached && cached.complete && cached.naturalWidth > 0) ||
          (mediaUrl(previewImage.currentSrc || previewImage.getAttribute("src") || "") === href &&
            previewImage.complete &&
            previewImage.naturalWidth > 0),
      );
    };

    const showImage = (src: string, next: number) => {
      const href = mediaUrl(src);
      const cached = preloadImage(src);

      if (mediaUrl(previewImage.currentSrc || previewImage.getAttribute("src") || "") !== href) {
        previewImage.classList.remove("is-active");
        previewImage.src = href;
      }

      previewImage.hidden = false;

      const activate = () => {
        if (next !== token) return;
        previewImage.classList.add("is-active");
        if (!previewVideo.classList.contains("is-active")) setLoading(false);
      };

      if (imageReady(src) || (cached && cached.complete && cached.naturalWidth > 0)) {
        activate();
        return;
      }

      setLoading(true);
      const onReady = () => {
        previewImage.removeEventListener("load", onReady);
        previewImage.removeEventListener("error", onReady);
        activate();
      };
      previewImage.addEventListener("load", onReady, { once: true });
      previewImage.addEventListener("error", onReady, { once: true });
    };

    const playPreviewVideo = (src: string, next: number) => {
      const href = mediaUrl(src);
      const cached = preloadVideo(src);
      const ready =
        cached && cached.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA;

      if (mediaUrl(previewVideo.currentSrc || previewVideo.getAttribute("src") || "") !== href) {
        previewVideo.src = href;
      }

      previewVideo.hidden = false;
      previewVideo.muted = true;
      previewVideo.defaultMuted = true;
      previewVideo.volume = 0;

      const activate = () => {
        if (next !== token) return;
        previewVideo.classList.add("is-active");
        hideImage();
        setLoading(false);
        void previewVideo.play().catch(() => {});
      };

      if (ready || previewVideo.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
        activate();
        return;
      }

      setLoading(true);
      const onReady = () => {
        previewVideo.removeEventListener("loadeddata", onReady);
        previewVideo.removeEventListener("canplay", onReady);
        activate();
      };
      previewVideo.addEventListener("loadeddata", onReady, { once: true });
      previewVideo.addEventListener("canplay", onReady, { once: true });
      void previewVideo.play().catch(() => {});
    };

    const show = (row: HTMLElement) => {
      if (activeRow === row) return;

      const image = row.dataset.image?.trim();
      const video = row.dataset.video?.trim();
      const next = ++token;
      activeRow = row;

      if (!image && !video) {
        clear();
        return;
      }

      preview.dataset.empty = "false";

      // Still frame while video warms (or as the final state) — only once decoded.
      if (image) {
        showImage(image, next);
      } else {
        hideImage();
        if (video) setLoading(true);
      }

      if (video) {
        playPreviewVideo(video, next);
        return;
      }

      hideVideo();
    };

    // Warm the first main-item media as soon as the pointer enters the list.
    list.addEventListener(
      "pointerenter",
      () => {
        warmAll();
      },
      { once: true },
    );

    rows.forEach((row) => {
      row.addEventListener("pointerenter", () => {
        const image = row.dataset.image?.trim();
        const video = row.dataset.video?.trim();
        if (image) preloadImage(image);
        if (video) preloadVideo(video);
        show(row);
      });
      row.addEventListener("focus", () => show(row));
    });

    list.addEventListener("mouseleave", clear);
  }

  document.addEventListener("astro:page-load", initWorkPreview);
  initWorkPreview();
</script>
